# =============================================================================
# Text-to-SQL Thesis — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API key.
#
# RECOMMENDED: Use OpenRouter (single API key for all models).
# Purchase key at: https://openrouter.ai/keys
# =============================================================================

# ── OpenRouter (recommended) ─────────────────────────────────────────────────
# Single API key — change OPENROUTER_MODEL to switch between models.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_model_name_here

# Common model names for OpenRouter (use one at a time):
#   google/gemini-2.5-pro
#   anthropic/claude-sonnet-4
#   openai/gpt-4o
#   meta-llama/llama-4-maverick

# ── Provider override (optional) ─────────────────────────────────────────────
# Auto-detected based on which API key is set. Override manually if needed:
# LLM_PROVIDER=openrouter

# ── Legacy direct API keys (not needed if using OpenRouter) ──────────────────
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ── Debug ─────────────────────────────────────────────────────────────────────
# LLM_DEBUG=1
